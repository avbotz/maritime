/ {
	zephyr,user {
		io-channels = <&adc 0>;
	};

	/* Dropper and shooter servos are ser-110x model */
	dropper_servo: dropper_servo {
		compatible = "avbotz,pwm-servo";
		pwms = <&pwm 5 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		min-pulse = <PWM_USEC(800)>;
		max-pulse = <PWM_USEC(1700)>;
	};

	shooter_servo: shooter_servo {
		compatible = "avbotz,pwm-servo";
		pwms = <&pwm 4 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		min-pulse = <PWM_USEC(800)>;
		mid-pulse = <PWM_USEC(1150)>;
		max-pulse = <PWM_USEC(1700)>;
	};

	/* The grabber servo is the ser-120x model. */
	/*
	 * grabber_servo: grabber_servo {
	 *	compatible = "avbotz,pwm-servo";
	 *	pwms = <&pwm 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
	 *	min-pulse = <PWM_USEC(800)>;
	 *	max-pulse = <PWM_USEC(2100)>;
	 * };
	 */

	killswitch: killswitch {
		compatible = "avbotz,killswitch";

		gpios = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		kill-debounce-ms = <10>;
		release-debounce-ms = <50>;
	};

	thrusters {
		compatible = "avbotz,pwm-thrusters";

		min-pulse = <PWM_USEC(1100)>;
		max-pulse = <PWM_USEC(1900)>;

		max-throttle = <100>;

		/*
		 * One thruster's current draw: the T200 at 18 V. Data from Blue Robotics T200 technical
		 * specifications. Line k of current-pulses matches line k of current-milliamps.
		 */
		current-pulses = <PWM_USEC(1100) PWM_USEC(1120) PWM_USEC(1140) PWM_USEC(1160)
				  PWM_USEC(1180) PWM_USEC(1200) PWM_USEC(1220) PWM_USEC(1240)
				  PWM_USEC(1260) PWM_USEC(1280) PWM_USEC(1300) PWM_USEC(1320)
				  PWM_USEC(1340) PWM_USEC(1360) PWM_USEC(1380) PWM_USEC(1400)
				  PWM_USEC(1420) PWM_USEC(1440) PWM_USEC(1460) PWM_USEC(1480)
				  PWM_USEC(1500) PWM_USEC(1520) PWM_USEC(1540) PWM_USEC(1560)
				  PWM_USEC(1580) PWM_USEC(1600) PWM_USEC(1620) PWM_USEC(1640)
				  PWM_USEC(1660) PWM_USEC(1680) PWM_USEC(1700) PWM_USEC(1720)
				  PWM_USEC(1740) PWM_USEC(1760) PWM_USEC(1780) PWM_USEC(1800)
				  PWM_USEC(1820) PWM_USEC(1840) PWM_USEC(1860) PWM_USEC(1880)
				  PWM_USEC(1900)>;
		current-milliamps = <28215 25380 22210 18850
				     15800 13270 11320 9550
				     7770 6000 4790 3680
				     2730 1900 1300 800
				     400 200 50 0
				     0 0 50 200
				     400 800 1300 1830
				     2700 3600 4720 5970
				     7640 9480 11180 13120
				     15550 18450 21600 24770
				     27570>;

		/* 75 A across all eight thrusters */
		max-current = <75000>;

		thruster0: thruster0 {
			pwms = <&pwm 9 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster1: thruster1 {
			pwms = <&pwm 8 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster2: thruster2 {
			pwms = <&pwm 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster3: thruster3 {
			pwms = <&pwm 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster4: thruster4 {
			pwms = <&pwm 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster5: thruster5 {
			pwms = <&pwm 6 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster6: thruster6 {
			pwms = <&pwm 7 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster7: thruster7 {
			pwms = <&pwm 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	chosen {
		zephyr,console = &cdc_acm_uart0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* Uses P0 and P1 by default, which clashes with thrusters 4 and 7. */
&uart0 {
	status = "disabled";
};

&pwm {
	status = "okay";

	pinctrl-0 = <&pwm_default>;
};

&adc {
	status = "okay";
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	pressure: channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&pinctrl {
	pwm_default: pwm_default {
		group1 {
			pinmux = <PWM_0A_P0 PWM_0B_P1
				  PWM_1A_P2 PWM_1B_P3
				  PWM_3A_P6 PWM_3B_P7
				  PWM_4A_P8 PWM_4B_P9
				  PWM_2A_P20 PWM_2B_P21>;
		};
	};

	/* The board's state also takes P27-P29 for the ADC and P28 is the kill switch, so restrict ADC to P26 only. */
	adc_default: adc_default {
		group1 {
			pinmux = <ADC_CH0_P26>;
		};
	};
};
