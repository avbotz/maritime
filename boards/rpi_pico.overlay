/ {
	zephyr,user {
		io-channels = <&adc 0>;
	};

	/* Dropper and shooter servos are ser-110x model */
	dropper_servo: dropper_servo {
		compatible = "avbotz,pwm-servo";
		pwms = <&pwm 5 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		min-pulse = <PWM_USEC(800)>;
		max-pulse = <PWM_USEC(1700)>;
	};

	shooter_servo: shooter_servo {
		compatible = "avbotz,pwm-servo";
		pwms = <&pwm 4 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		min-pulse = <PWM_USEC(800)>;
		mid-pulse = <PWM_USEC(1150)>;
		max-pulse = <PWM_USEC(1700)>;
	};

	/* The grabber servo is the ser-120x model. */
	/*
	 * grabber_servo: grabber_servo {
	 *	compatible = "avbotz,pwm-servo";
	 *	pwms = <&pwm 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
	 *	min-pulse = <PWM_USEC(800)>;
	 *	max-pulse = <PWM_USEC(2100)>;
	 * };
	 */

	killswitch: killswitch {
		compatible = "avbotz,killswitch";

		gpios = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		kill-debounce-ms = <10>;
		release-debounce-ms = <50>;
	};

	thrusters {
		compatible = "avbotz,pwm-thrusters";

		min-pulse = <PWM_USEC(1100)>;
		max-pulse = <PWM_USEC(1900)>;

		max-power = <60>;

		thruster0: thruster0 {
			pwms = <&pwm 9 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster1: thruster1 {
			pwms = <&pwm 8 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster2: thruster2 {
			pwms = <&pwm 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster3: thruster3 {
			pwms = <&pwm 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster4: thruster4 {
			pwms = <&pwm 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster5: thruster5 {
			pwms = <&pwm 6 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster6: thruster6 {
			pwms = <&pwm 7 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		thruster7: thruster7 {
			pwms = <&pwm 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	chosen {
		zephyr,console = &cdc_acm_uart0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* Uses P0 and P1 by default, which clashes with thrusters 4 and 7. */
&uart0 {
	status = "disabled";
};

&pwm {
	status = "okay";

	pinctrl-0 = <&pwm_default>;
};

&adc {
	status = "okay";
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	pressure: channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&pinctrl {
	pwm_default: pwm_default {
		group1 {
			pinmux = <PWM_0A_P0 PWM_0B_P1
				  PWM_1A_P2 PWM_1B_P3
				  PWM_3A_P6 PWM_3B_P7
				  PWM_4A_P8 PWM_4B_P9
				  PWM_2A_P20 PWM_2B_P21>;
		};
	};

	/* The board's state also takes P27-P29 for the ADC and P28 is the kill switch, so restrict ADC to P26 only. */
	adc_default: adc_default {
		group1 {
			pinmux = <ADC_CH0_P26>;
		};
	};
};
