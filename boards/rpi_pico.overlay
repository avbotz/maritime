/ {
    aliases {
        ahrsuart = &uart1;
    };

    /* Grabber and shooter servos are ser-110x model */
    dropper_servo: dropper_servo {
        compatible = "pwm-servo";
        pwms = <&pwm 12 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        min-pulse = <PWM_USEC(850)>;
        max-pulse = <PWM_USEC(2100)>; /* This sus value works */
    };

    /* The grabber servo is the ser-120x model */
    grabber_servo: grabber_servo {
        compatible = "pwm-servo";
        pwms = <&pwm 10 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        min-pulse = <PWM_USEC(800)>;
        max-pulse = <PWM_USEC(2100)>;
    };

    shooter_servo: shooter_servo {
        compatible = "pwm-servo";
        pwms = <&pwm 11 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        min-pulse = <PWM_USEC(850)>;
        max-pulse = <PWM_USEC(2250)>;
    };

    // Communicate with the killswitch as a gpio "button" on pin PH1
    buttons {
        compatible = "gpio-keys";
        killswitch_button: killswitch_button {
            /* GPIO 28 */
            gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
            label = "Killswitch modeled as a button";
        };
    };

    thrusters {
        compatible = "pwm-leds";
        thruster0: thruster0 {
            pwms = <&pwm 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
        thruster1: thruster1 {
            pwms = <&pwm 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
        thruster2: thruster2 {
            pwms = <&pwm 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
        thruster3: thruster3 {
            pwms = <&pwm 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
        thruster4: thruster4 {
            pwms = <&pwm 6 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
        thruster5: thruster5 {
            pwms = <&pwm 7 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
        thruster6: thruster6 {
            pwms = <&pwm 8 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
        thruster7: thruster7 {
            pwms = <&pwm 9 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
    };

    chosen {
        zephyr,console = &cdc_acm_uart0;
    };
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

&pwm {
    status = "okay";
    divider-frac-1 = <15>;
    divider-int-1 = <255>;
    divider-frac-2 = <15>;
    divider-int-2 = <255>;
    divider-frac-3 = <15>;
    divider-int-3 = <255>;
    divider-frac-4 = <15>;
    divider-int-4 = <255>;
    divider-frac-5 = <15>;
    divider-int-5 = <255>;
    divider-frac-6 = <15>;
    divider-int-6 = <255>;
    divider-frac-7 = <15>;
    divider-int-7 = <255>;
};

&pinctrl {
    uart1_default: uart1_default {
        group1 {
            pinmux = <UART1_TX_P4>;
        };

        group2 {
            pinmux = <UART1_RX_P5>;
            input-enable;
        };
    };
};

&pwm_ch4b_default {
    group1 {
        pinmux = <PWM_0A_P0 PWM_0B_P1 PWM_1A_P2 PWM_1B_P3>;
    };
};

&uart1 {
    current-speed = <115200>;
    status = "okay";
    pinctrl-0 = <&uart1_default>;
    pinctrl-names = "default";
};
